\begin_inset Formula 
\[
\begin{split} & \|\widehat{\theta}_{t}-\theta_{\star}\|_{\Gb_{t}}\\
 & =\Big\Vert(\Gb_{t}-\Vb_{t})(\theta_{t}^{R}-\theta_{\star})+\sum_{s=1}^{t}\eta_{a_{s},s}X_{a_{s},s}\Big\Vert_{\Gb_{t}^{-1}}.
\end{split}
\]

\end_inset

By definition of 
\begin_inset Formula $\theta_{t}^{R}=\Gb_{t}^{-1}\sum_{s=1}^{t}Y_{a_{s},s}X_{a_{s},s}$
\end_inset

,
\begin_inset Formula 
\[
\theta_{t}^{R}-\theta_{\star}=\Gb_{t}^{-1}\sum_{s=1}^{t}\eta_{a_{s},s}X_{a_{s},s}
\]

\end_inset

 It follows that 
\begin_inset Formula 
\[
\begin{split} & \|\widehat{\theta}_{t}-\theta_{\star}\|_{\Gb_{t}}\\
 & =\Big\Vert(\Ib_{d}-\Vb_{t}\Gb_{t}^{-1})\sum_{s=1}^{t}\eta_{a_{s},s}X_{a_{s},s}\Big\Vert_{\Gb_{t}^{-1}}\\
 & =\Big\Vert(\Ib_{d}-\Gb_{t}^{-1/2}\Vb_{t}\Gb_{t}^{-1/2})\Gb_{t}^{-1/2}\sum_{s=1}^{t}\eta_{a_{s},s}X_{a_{s},s}\Big\Vert_{2}.
\end{split}
\]

\end_inset

By definition of the matrix operator norm,
 
\begin_inset Formula $\|M\|_{2}:=\max_{\|x\|_{2}\le1}\|Mx\|_{2}$
\end_inset

,
 
\begin_inset Formula 
\begin{align*}
 & \|\widehat{\theta}_{t}-\theta_{\star}\|_{\Gb_{t}}\\
 & \le\Big\Vert\Ib_{d}-\Gb_{t}^{-1/2}\Vb_{t}\Gb_{t}^{-1/2}\Big\Vert_{2}\cdot\Big\Vert\sum_{s=1}^{t}\eta_{a_{s},s}X_{a_{s},s}\Big\Vert_{\Gb_{t}^{-1}}.
\end{align*}

\end_inset

By Lemma ??
\begin_inset Formula 
\begin{align*}
\Big\Vert2\Ib_{d}-\Gb_{t}^{-1/2}\Vb_{t}\Gb_{t}^{-1/2}\Big\Vert_{2}\le & 1+\Big\Vert\Ib_{d}-\Gb_{t}^{-1/2}\Vb_{t}\Gb_{t}^{-1/2}\Big\Vert_{2}\\
\le & 3.
\end{align*}

\end_inset

Thus,
