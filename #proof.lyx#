\begin_layout Proof
By definition,
 recall that 
\begin_inset Formula 
\begin{align*}
\Gb_{t} & =\sum_{s=1}^{t}\sum_{k=1}^{K}\bar{\pi}_{s}(k)X_{k,s}X_{k,s}^{\top}+\lambda_{t}I_{d}
\end{align*}

\end_inset

Let us write 
\begin_inset Formula $\eta_{a_{s},s}:=Y_{a_{s},s}-X_{a_{s},s}^{\top}\theta_{\star}$
\end_inset

.
 By definition of the estimator and the Gram matrix,
\begin_inset Formula 
\[
\begin{split} & \widehat{\theta}_{t}-\theta_{\star}\\
 & =\Gb_{t}^{-1}\Big(\sum_{s=1}^{t}\sum_{k=1}^{K}\big(\bar{\pi}_{s}(k)-\II(a_{s}=k)\big)X_{k,s}X_{k,s}^{\top}(\theta_{t}^{R}-\theta_{\star})+\sum_{s=1}^{t}\eta_{a_{s},s}X_{a_{s},s}\Big).
\end{split}
\]

\end_inset

Let us write 
\begin_inset Formula $\Vb_{t}:=\sum_{s=1}^{t}\sum_{k=1}^{K}\II(a_{s}=k)X_{k,s}X_{k,s}^{\top}+\lambda_{t}\Ib_{d}$
\end_inset

.
