\begin_inset Formula 
\[
\|X_{a_{s},s}\|_{\bar{\Gb}_{t}^{-1}}^{2}\le\sum_{k=1}^{K}(\sqrt{p_{s}(k)}X_{k,s})^{\top}\bar{\Gb}_{t}^{-1}(\sqrt{p_{s}(k)}X_{k,s}).
\]

\end_inset

Because 
\begin_inset Formula $\bar{\Gb}_{t}=\frac{1}{2}\sum_{k=1}^{K}(\sqrt{p_{s}(k)}X_{k,s})(\sqrt{p_{s}(k)}X_{k,s})^{\top}+\lambda_{t}\Ib_{d}$
\end_inset

,
\begin_inset Formula 
\begin{align*}
\sum_{s=1}^{t}\EE[D_{i,a_{s}}^{2}|\Hcal_{s-1}]\le & \sum_{s=1}^{t}\sum_{k=1}^{K}(\sqrt{p_{s}(k)}X_{k,s})^{\top}\bar{\Gb}_{t}^{-1}(\sqrt{p_{s}(k)}X_{k,s})\\
= & \text{Tr}\Big(\sum_{s=1}^{t}\sum_{k=1}^{K}(\sqrt{p_{s}(k)}X_{k,s})(\sqrt{p_{s}(k)}X_{k,s})^{\top}\bar{\Gb}_{t}^{-1}\Big)\\
\le & 2\text{Tr}\Big(\bar{\Gb}_{t}\bar{\Gb}_{t}^{-1}\Big)=2d.
\end{align*}

\end_inset

Thus,
 with probability at least 
\begin_inset Formula $1-\delta$
\end_inset

,
 
\begin_inset Formula 
\[
H_{i,t}\big(\sqrt{2\sigma^{2}\log\frac{2t^{2}}{\delta}}\big)=\sum_{s=1}^{t}\EE[D_{i,a_{s}}^{2}|\Hcal_{s-1}]\le2d.
\]

\end_inset

Thus,
 for any 
\begin_inset Formula $z>0$
\end_inset

,
 
\begin_inset Formula 
\[
\PP(\max_{t\ge1}|\sum_{s=1}^{t}D_{i,a_{s}}|\ge z)=\PP(\max_{t\ge1}|\sum_{s=1}^{t}D_{i,a_{s}}|\ge z,H_{i,t}\big(\sqrt{2\sigma^{2}\log\frac{2t^{2}}{\delta}}\big)\le2d)+\delta
\]

\end_inset

By Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:Van_Zanten"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

,
 for any 
\begin_inset Formula $z>0$
\end_inset

,
 
\begin_inset Formula 
\[
\PP(\max_{t\ge1}|\sum_{s=1}^{t}D_{i,a_{s}}|\ge z)\le2\exp\Big(-\frac{z^{2}}{4d+\frac{2}{3}\frac{\sqrt{2\sigma^{2}\log\frac{2t^{2}}{\delta}}}{3}z}\Big)+\delta.
\]

\end_inset

The inequality 
\begin_inset Formula 
\[
2\exp\Big(-\frac{z^{2}}{4d+\frac{2\sqrt{2\sigma^{2}\log\frac{2t^{2}}{\delta}}}{3}z}\Big)\le\delta
\]

\end_inset

 is equivalent to
\begin_inset Formula 
\[
z^{2}-z\frac{2\sqrt{2\sigma^{2}\log\frac{2t^{2}}{\delta}}}{3}\log\frac{2}{\delta}-4d\log\frac{2}{\delta}\ge0.
\]

\end_inset

The above inequality is implied by
\begin_inset Formula 
\[
z\ge\frac{2\sqrt{2\sigma^{2}\log\frac{2t^{2}}{\delta}}}{3}\log\frac{2}{\delta}+\sqrt{4d\log\frac{2}{\delta}}.
\]

\end_inset

Thus,
 with probability at least 
\begin_inset Formula $1-2\delta$
\end_inset

,
 for all 
\begin_inset Formula $t\ge1$
\end_inset

,
\begin_inset Formula 
\[
|\sum_{s=1}^{t}D_{i,a_{s}}|\le\frac{2\sqrt{2\sigma^{2}\log\frac{2t^{2}}{\delta}}}{3}\log\frac{2}{\delta}+\sqrt{4d\log\frac{2}{\delta}},
\]

\end_inset

and it follows that
\begin_inset Formula 
\[
\Big\Vert\sum_{s=1}^{t}\eta_{a_{s},s}X_{a_{s},s}\Big\Vert_{\Gb_{t}^{-1}}\le\frac{4\sqrt{2\sigma^{2}\log\frac{2t^{2}}{\delta}}}{3}\log\frac{2}{\delta}+4\sqrt{d\log\frac{2}{\delta}}.
\]

\end_inset

 
\end_layout

\begin_layout Lemma
\begin_inset CommandInset label
LatexCommand label
name "lem:Van_Zanten"

\end_inset

 (Inequalities Van Zantan) For any 
\begin_inset Formula $n\ge1$
\end_inset

,
 let 
\begin_inset Formula $\xi_{n}$
\end_inset

 denote the martingale difference adapted to the sequence 
\begin_inset Formula $\Fcal_{n}$
\end_inset

.
 For each 
\begin_inset Formula $a>0$
\end_inset

,
 let 
\begin_inset Formula $H_{n}(a)=\sum_{i=1}^{n}\xi_{i}^{2}\II(|\xi_{i}|>a)+\sum_{i=1}^{n}\EE[\xi_{i}^{2}|\Fcal_{i-1}]$
\end_inset

.
 Then for any 
\begin_inset Formula $z>0,a>0$
\end_inset

 and 
\begin_inset Formula $L>0$
\end_inset

,
 
\begin_inset Formula 
\[
\PP\Big(\max_{n}|\sum_{i=1}^{n}\xi_{i}|>z,H_{n}(a)\le L\Big)\le2\exp(-\frac{z^{2}}{2L+\frac{2}{3}az}).
\]

\end_inset

 
\end_layout

